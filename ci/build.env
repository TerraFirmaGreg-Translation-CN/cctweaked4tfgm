# cctweaked4tfgm CI configuration.
# Sourced by ci/run.sh. Assignments use ${VAR:-default} so environment
# overrides (workflow inputs, local runs) survive.

NODE_VERSION="${NODE_VERSION:-24}"

MODPACK_REPO="${MODPACK_REPO:-https://github.com/TerraFirmaGreg-Team/Modpack-Modern.git}"
# Empty = latest semver release tag.
MODPACK_TAG="${MODPACK_TAG:-}"
# Empty = read from the target tag's pakku-lock.json.
CC_VERSION="${CC_VERSION:-}"

# Public exports the site links into.
RECIPE_BOOK_BASE_URL="${RECIPE_BOOK_BASE_URL:-https://wiki.terrafirmagreg.team/modern/recipe-book/}"
QUEST_BOOK_BASE_URL="${QUEST_BOOK_BASE_URL:-https://wiki.terrafirmagreg.team/modern/quest-book/}"
WIKI_BASE_URL="${WIKI_BASE_URL:-https://wiki.terrafirmagreg.team/}"

SITE_URL="${SITE_URL:-https://terrafirmagreg-translation-cn.github.io/cctweaked4tfgm/}"
